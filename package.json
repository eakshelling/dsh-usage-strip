{
  "name": "dsh-usage-strip",
  "version": "1.3.0",
  "description": "Composer usage strip: this chat's total cost and today's tokens/cost, a switch to all local DSH sessions, and the official price-change timeline.",
  "license": "MIT",
  "author": "Eakshell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eakshell/dsh-usage-strip.git"
  },
  "homepage": "https://github.com/Eakshell/dsh-usage-strip#readme",
  "bugs": {
    "url": "https://github.com/Eakshell/dsh-usage-strip/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "cost",
    "pricing"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "index.js",
    "aggregate.js",
    "pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
